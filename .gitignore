# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE settings
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Logs
*.log

# Environment files
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]

# Python virtual environments
.venv/
venv/

# Node dependencies and build output
node_modules/
dist/
build/
coverage/

# Behavior-evaluation harness: generated reports/transcripts are run
# output, not source -- they may also contain sensitive session
# content depending on what a live run was asked to evaluate. API
# keys are already covered by the .env rules above; ANTHROPIC_API_KEY
# should be set as an environment variable, never committed.
evals/harness/reports/
evals/harness/*.local.json
